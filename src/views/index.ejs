        }

        .custom-textarea:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.1);
        }

        /* Estilos específicos para el redimensionamiento */
        .custom-textarea::-webkit-resizer {
            display: none;
        }

        .custom-textarea {
            position: relative;
        }

        .custom-textarea::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 10px;
            cursor: ns-resize;
            background: transparent;
        }

        .custom-textarea:hover {
            border-bottom: 2px solid #3b82f6;
        }
    </style>
</head>
