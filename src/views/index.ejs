            overflow-y: auto;
        }
        
        /* Estilo para el scroll */
        .modal-content::-webkit-scrollbar {
            width: 8px;
        }
        
        .modal-content::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }
        
        .modal-content::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 4px;
        }
        
        .modal-content::-webkit-scrollbar-thumb:hover {
            background: #555;
        }

        .resize-handle {
            position: absolute;
            right: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            cursor: col-resize;
            user-select: none;
        }

        .resize-handle:hover,
        .resize-handle.active {
            background: rgba(0, 0, 0, 0.1);
        }

        .table-fixed {
            table-layout: fixed;
        }

        th, td {
            position: relative;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* Personalizar la barra de scroll */
        .overflow-y-auto::-webkit-scrollbar {
            width: 6px;
        }
        
        .overflow-y-auto::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 3px;
        }
        
        .overflow-y-auto::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 3px;
        }
        
        .overflow-y-auto::-webkit-scrollbar-thumb:hover {
            background: #666;
        }

        /* Ocultar scrollbar en Firefox */
        .overflow-y-auto {
            scrollbar-width: thin;
            scrollbar-color: #888 #f1f1f1;
        }

        /* Asegurar que el modal no sea más alto que la ventana */
        .modal-container {
            max-height: calc(100vh - 40px);
            margin: 20px auto;
        }

        /* Estilos globales para inputs */
        .form-input {
            @apply mt-1 block w-full rounded-lg border-gray-300 bg-white shadow-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500;
        }

        .container-section {
            @apply bg-gray-100 rounded-lg border border-gray-200 shadow-sm p-4;
        }

        .input-group {
            @apply bg-white rounded-lg border border-gray-300 shadow-md p-4;
        }

        /* Contenedor del textarea */
        .textarea-container {
            position: relative;
            width: 100%;
        }

        /* Estilos del textarea */
        .resize-textarea {
            resize: none;
            min-height: 200px;
            width: 100%;
        }

        /* Barra de redimensionamiento personalizada */
        .resize-handle {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: transparent;
            cursor: ns-resize;
        }

        .resize-handle:hover {
            background: rgba(59, 130, 246, 0.1);
        }

        /* Estilo para el contenedor cuando se está redimensionando */
        .textarea-container.resizing textarea {
            pointer-events: none;
        }

        /* Estilos para el textarea redimensionable */
        .custom-textarea {
            width: 100%;
            min-height: 200px;
            padding: 8px;
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            resize: vertical;
            overflow: auto;
            line-height: 1.5;
