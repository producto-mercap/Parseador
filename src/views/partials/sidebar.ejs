<!-- Panel lateral -->
<div 
    :class="sidebarCollapsed ? 'w-0 overflow-hidden' : 'w-64'"
    class="flex-shrink-0 bg-gray-50 shadow-lg transition-all duration-300 relative">
    <div class="p-4" x-show="!sidebarCollapsed">
        <!-- Botón Nuevo Parseador -->
        <button 
            @click="showModal = true"
            class="google-action-btn google-action-btn--primary w-full">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <span>Nuevo Parseador</span>
        </button>

        <!-- Lista de parseadores -->
        <nav class="mt-4 space-y-2">
            <template x-if="parsers.length === 0">
                <div class="text-gray-500 text-sm p-2">
                    No hay parseadores configurados
                </div>
            </template>
            <template x-for="parser in parsers" :key="parser.id">
                <div 
                    class="flex items-center justify-between p-2 hover:bg-gray-50 rounded-lg cursor-pointer"
                    @click="selectedParser = parser"
                    :class="{'bg-blue-50': selectedParser?.id === parser.id}">
                    <div class="flex justify-between items-center w-full">
                        <span class="text-gray-600" x-text="parser.nombre"></span>
                        <div class="flex items-center">
                            <button 
                                @click="editarParser($event, parser.id)" 
                                class="ml-2 text-gray-400 hover:text-blue-500">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 102.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </template>
        </nav>
    </div>
</div>

