<!-- Tabla de resultados en contenedor separado -->
<div class="w-full relative">
    <!-- Scrollbar superior duplicada (sticky) -->
    <div class="table-scrollbar-top sticky top-0 z-40 bg-white border-b border-gray-200" id="tableScrollbarTop" style="display: none;">
        <div class="overflow-x-auto" id="tableScrollbarTopInner" style="height: 40px;">
            <div id="tableScrollbarTopContent" style="height: 1px;"></div>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow overflow-hidden overflow-x-auto table-container" id="tableScrollContainer">
        <table class="data-table min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <!-- Los encabezados se insertarán aquí dinámicamente -->
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                <!-- Las filas se insertarán aquí dinámicamente -->
            </tbody>
        </table>
    </div>
</div>

